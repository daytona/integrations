{
  "name": "@daytona/claude-toolsets",
  "version": "0.0.0",
  "description": "Daytona sandbox drivers for the Anthropic SDK's computer and browser toolsets — hand one to the SDK's tool runner and Claude drives a desktop or a Chromium running in an isolated Daytona sandbox",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daytona/integrations.git",
    "directory": "packages/claude-toolsets"
  },
  "author": "Daytona Platforms Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/daytona/integrations/issues"
  },
  "homepage": "https://github.com/daytona/integrations/tree/main/packages/claude-toolsets#readme",
  "keywords": [
    "daytona",
    "sandbox",
    "anthropic",
    "claude",
    "computer-use",
    "browser-use",
    "cua",
    "browser",
    "toolset",
    "agent",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:run-computer": "tsx examples/runComputer.ts",
    "example:run-browser": "tsx examples/runBrowser.ts",
    "example:exercise-computer": "tsx examples/exerciseComputer.ts",
    "example:exercise-browser": "tsx examples/exerciseBrowser.ts"
  },
  "dependencies": {
    "@daytona/sdk": "^0.223.0",
    "playwright-core": "^1.49.0",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.132.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
